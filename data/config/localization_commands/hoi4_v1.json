  "notes": [
    {
      "text": "Bracketed [Scope.Command] text is replaced at runtime. Keep every command exactly; scopes such as ROOT, FROM, country tags (GER), state IDs ([608.GetName]) and owner/controller/capital are script identifiers, not translatable text.",
      "provenance": "wiki"
    },
    {
      "text": "[?variable] prints a variable's value; keep the whole token including its |format characters (for example |%, |0, |+).",
      "provenance": "wiki"
    },
    {
      "text": "Formatting uses §X ... §! colour codes; £icon£ and @TAG are icons and flags. Hash markers such as #P are not HoI4 formatting and display as literal text.",
      "provenance": "inferred"
    }
  ],
  "language_notes": {
    "zh-CN": [
      {
        "text": "中文本地化里代词命令输出他/她；中文没有主格宾格之分，任何代词命令都可作主语或宾语。",
        "provenance": "user"
      },
      {
        "text": "因中文习惯省略重复的代词命令是合理的，前提是指代仍然清楚；不要把代词命令写死成“他”或“她”。没有必要时，应尽量保持与原文相同的命令引用。",
        "provenance": "user"
      }
    ]
  },
  "suffixes": {
    "Cap": "same output with the first letter capitalised",
    "Long": "long form",
    "Noun": "noun form",
    "Short": "short form",
    "CAP": "same output with the first letter capitalised",
    "WithCaps": "capitalised form"
  },
